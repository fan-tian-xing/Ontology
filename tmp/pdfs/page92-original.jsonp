window.page92_callback(["<div class=\"newpage\" id=\"page92\" style=\"width: 902px; height:1148px\">\n<div class=text_layer style=\"z-index:2\"><div class=ie_fix>\n&nbsp;\n<div class=\"ff1\" style=\"font-size:66px\">\n<span class=a style=\"left:5px;top:586px;letter-spacing:-1px\">机本体安装及维护说明书</span></div>\n<div class=\"ff3\" style=\"font-size:68px\">\n<span class=a style=\"left:1331px;top:591px;word-spacing:576px;letter-spacing:-8px\"> D<span class=w6></span>300N<span class=l9>-<span class=w8></span>000<span class=l6>105ASM</span></span></span><span class=a style=\"left:2704px;top:4248px;letter-spacing:-4px\">-3-3</span></div>\n<div class=\"ff1\" style=\"font-size:58px\">\n<span class=a style=\"left:3710px;top:738px\">说明</span><span class=a style=\"left:2960px;top:877px;word-spacing:-4px;letter-spacing:2px\">1 <span class=w style=\"width:18px\"></span>本图表<span class=l7>给出了<span class=l7>不同长<span class=l7>度的<span class=w11></span>M20<span class=l6>～M5<span class=l7>3×3<span class=w9></span>常用碳</span></span></span></span></span></span><span class=a style=\"left:3022px;top:1016px\">钢螺栓和合金钢螺栓应达到的预紧力数值。用户可</span><span class=a style=\"left:3015px;top:1155px;word-spacing:15px;letter-spacing:2px\">根据螺<span class=l6>栓材料<span class=l7>、螺距<span class=w8></span>t 、螺<span class=l6>栓工作<span class=l6>长度<span class=w11></span>L<span class=w12></span>查出预<span class=l6>紧</span></span></span></span></span></span><span class=a style=\"left:3023px;top:1295px\">螺母应达到的转角ψ或螺栓绝对伸长△L。</span><span class=a style=\"left:2960px;top:1434px;word-spacing:5px;letter-spacing:1px\">2 <span class=w11></span>本图表字符<span class=l7>意义如下：</span></span><span class=a style=\"left:3209px;top:1573px;letter-spacing:2px\">t——<span class=l6>螺距<span class=w10></span>mm</span></span><span class=a style=\"left:3195px;top:1712px\">△L——螺栓绝对伸长</span><span class=a style=\"left:3195px;top:1852px\">ψ——紧固后螺母应达到的转角度</span><span class=a style=\"left:3225px;top:1991px;letter-spacing:1px\">L——螺栓<span class=l6>工作长度<span class=w10></span>mm</span></span><span class=a style=\"left:3225px;top:2130px;word-spacing:5px;letter-spacing:2px\">L=L1 +d</span><span class=a style=\"left:3225px;top:2269px;word-spacing:9px;letter-spacing:2px\">d ——螺栓公<span class=l7>称直径<span class=w9></span>mm</span></span><span class=a style=\"left:3225px;top:2408px\">L1</span></div>\n<div class=\"ff4\" style=\"font-size:61px\">\n<span class=a style=\"left:3272px;top:2398px\"> —— </span></div>\n<div class=\"ff1\" style=\"font-size:58px\">\n<span class=a style=\"left:3404px;top:2408px\">见下图</span></div>\n<div class=\"ff1\" style=\"font-size:66px\">\n<span class=a style=\"left:2499px;top:3935px\">图</span></div>\n<div class=\"ff3\" style=\"font-size:68px\">\n<span class=a style=\"left:2584px;top:3940px;letter-spacing:-5px\">3-3-1</span></div>\n</div>\n</div>\n<div class=image_layer style=\"z-index: 1\">\n<div class=ie_fix>\n<img class=\"absimg\" style=\"left:-1px;top:136px;width:904px;height:682px;clip:rect(1px 903px 650px 1px)\" orig=\"http://html.scribd.com/b7li9jzk0dud3wm/images/92-cda9049335.jpg\"/>\n<img class=\"absimg\" style=\"left:-1px;top:178px;width:904px;height:682px;clip:rect(652px 903px 681px 1px)\" orig=\"http://html.scribd.com/b7li9jzk0dud3wm/images/92-cda9049335.jpg\"/>\n</div>\n</div>\n</div>\n\n"]);